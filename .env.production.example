# Copy to .env.production and obtain independent random secrets from your secret manager.
# This file is not a deploy command. Configure external TLS and restore-tested backups first.
NODE_ENV=production
COMPOSE_PROJECT_NAME=medicare-production
PORT=5000
FRONTEND_PORT=8080
DB_HOST=postgres
DB_PORT=5432
DB_NAME=healthcare
DB_OWNER_USER=healthcare_owner
DB_OWNER_PASSWORD=
DB_USER=healthcare_app
DB_PASSWORD=
DB_SSL=true
# PEM paths for self-managed PostgreSQL; keep private keys outside this repository.
POSTGRES_TLS_CERT_FILE=
POSTGRES_TLS_KEY_FILE=
POSTGRES_TLS_CA_FILE=
# Native migration/backup clients may use this trusted CA file.
DB_SSL_CA_FILE=
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
ENCRYPTION_KEY=
ENCRYPTION_ALGORITHM=aes-256-gcm
FRONTEND_URL=
CORS_ORIGIN=
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGIN=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
ADMIN_EMAIL=
CLAMAV_HOST=clamav
TRUST_PROXY=1
AUTO_LOGOUT_ENABLED=true
SESSION_TIMEOUT_MINUTES=30
AI_ENABLED=false
AI_SERVICE_URL=
AI_SERVICE_TOKEN=
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
METRICS_TOKEN=
METRICS_TOKEN_FILE=
ALERTMANAGER_CONFIG_FILE=
BACKUP_ENCRYPTION_KEY=
BACKUP_QUIESCED=false
PGSSLMODE=verify-full
