{
  "name": "healthcare-backend",
  "version": "1.0.0",
  "description": "Secure Healthcare Information & Patient Management System - Backend API",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:migrate": "node src/database/migrate.js",
    "db:seed": "node src/database/seed.js",
    "db:setup:all": "node src/database/setup_full_db.js",
    "test": "vitest run",
    "test:integration": "node scripts/run-integration-tests.js",
    "test:vitest": "vitest run",
    "test:vitest:watch": "vitest",
    "db:test": "node --test tests/database.integration.test.js",
    "db:bootstrap-admin": "node scripts/bootstrap-admin.js",
    "backup": "node scripts/backup.js",
    "backup:archive": "node scripts/backup-archive.js",
    "backup:online": "node scripts/database-snapshot.js",
    "backup:scheduled": "node scripts/scheduled-backup.js",
    "backup:restore-drill": "node scripts/restore-backup.js",
    "files:migrate-encryption": "node scripts/migrate-file-encryption.js",
    "check": "node scripts/check-syntax.js"
  },
  "keywords": [
    "healthcare",
    "HIPAA",
    "GDPR",
    "medical-records",
    "patient-management"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@simplewebauthn/server": "^13.2.2",
    "axios": "^1.13.4",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.3.1",
    "pg": "^8.11.3",
    "prom-client": "^15.1.3",
    "response-time": "^2.3.4",
    "uuid": "^14.0.3",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "supertest": "^7.3.1",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
