# Generate a local .env with: node scripts/setup-local.js (after backend npm ci).
# Do not use these local settings for production.
NODE_ENV=development
PORT=5000
DB_HOST=127.0.0.1
DB_PORT=55432
DB_NAME=healthcare
DB_USER=healthcare_owner
DB_PASSWORD=
DB_SSL=false
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
ENCRYPTION_KEY=
ENCRYPTION_ALGORITHM=aes-256-gcm
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000
EMAIL_HOST=127.0.0.1
EMAIL_PORT=1025
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=healthcare@localhost.invalid
CLAMAV_HOST=127.0.0.1
AUTO_LOGOUT_ENABLED=true
SESSION_TIMEOUT_MINUTES=30
AI_ENABLED=false
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_TOKEN=
GROQ_API_KEY=
PGADMIN_EMAIL=admin@localhost.invalid
PGADMIN_PASSWORD=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
METRICS_TOKEN=
# Backups use a separate 64-character hex key. Never bundle either key with data.
BACKUP_ENCRYPTION_KEY=
# A backup worker may receive this SHA-256 fingerprint instead of ENCRYPTION_KEY.
# The original application key remains required to use restored encrypted data.
BACKUP_APPLICATION_KEY_SHA256=
BACKUP_DATABASE_SCHEMA=healthcare
# Restricted to the private archive bucket and medicare-backups/ prefix.
# Supply through the backup operator's secret store, not application source.
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_ID=
B2_PREFIX=medicare-backups/
# Set only after writes have actually stopped for a coordinated backup.
BACKUP_QUIESCED=false
# Remote backup clients must verify PostgreSQL TLS and its certificate chain.
PGSSLMODE=verify-full
