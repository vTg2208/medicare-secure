# Enable AI in the API separately with AI_ENABLED=true. Keep these credentials server-side.
AI_SERVICE_TOKEN=
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
AI_RAG_ENABLED=false
# Optional local retrieval (install requirements-rag.txt / Docker build arg ENABLE_RAG=true).
# VECTOR_INDEX_PATH=/app/chroma_db
# CHROMA_PATH remains a fallback directory setting for existing deployments.
# MEDICAL_DOCS_DIR=/app/medical_docs
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# EMBEDDING_MODEL_REVISION=<reviewed model revision or commit>
