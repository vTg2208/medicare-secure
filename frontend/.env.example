# Browser-visible build-time settings. Never put secrets here.
# Blank or /api uses the same-origin proxy. An origin or URL ending /api is accepted.
REACT_APP_API_URL=/api
REACT_APP_APP_NAME=MediCare
# Integer milliseconds: 1000–120000; invalid values fall back to 15000.
# A free hosted backend may need 90000 while waking from sleep.
REACT_APP_API_TIMEOUT_MS=15000
