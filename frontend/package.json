{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@simplewebauthn/browser": "^13.2.2",
    "@yudiel/react-qr-scanner": "^2.5.1",
    "axios": "^1.21.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.18.5",
    "web-vitals": "6.2.3"
  },
  "scripts": {
    "start": "vite --host 0.0.0.0 --port 3000",
    "build": "npm run check:theme && npm run check:fonts && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src vite.config.mjs eslint.config.mjs",
    "check:theme": "node scripts/check-theme.mjs",
    "check:fonts": "node scripts/check-fonts.mjs",
    "vendor:fonts": "node scripts/vendor-fonts.mjs",
    "test:performance": "node scripts/performance-smoke.mjs"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "autoprefixer": "^10.4.24",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.1",
    "vite": "^8.3.5",
    "@vitejs/plugin-react": "^6.1.2",
    "vitest": "^5.0.5",
    "jsdom": "^27.4.0",
    "eslint": "^10.14.0",
    "@eslint/js": "^10.0.1",
    "globals": "^16.5.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/user-event": "^14.6.1",
    "playwright": "1.64.1"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
